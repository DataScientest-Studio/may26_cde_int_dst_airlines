@startuml airline_data_model        ' Initializes the UML diagram and assigns the internal name airline_data_model
!theme plain                        ' Applies a minimal, flat base theme to the diagram, removing default shadows and gradients.
skinparam linetype ortho            ' Forces relationship lines to route using right angles (orthogonal) rather than direct diagonal paths.
skinparam roundcorner 10            ' Applies a 10-pixel rounding radius to the corners of the diagram elements (like class boxes).
skinparam class {                   ' Opens a configuration block to apply specific styling rules to all class entities in the diagram.
    BackgroundColor White           ' Sets the interior fill color of the main body of the class boxes to white.
    BorderColor #2C3E50             ' Sets the outer border color of the class boxes to a dark slate blue.
    ArrowColor #2C3E50              ' Sets the color of the relationship lines and arrows connecting the classes to a dark slate blue.
    HeaderBackgroundColor #34495E   ' Sets the background color of the top header section (where the class name sits) to a dark blue-grey.
}

' Sets the main title that appears at the top of the rendered diagram
title Airline Data Engineering Platform - Entity Relationship Diagram (ERD)


' Defines an entity (table) with the display name and an internal alias
    ' The asterisk (*) denotes a mandatory (NOT NULL) field. 
    ' Double asterisks (**) render the text in bold.
    ' A double hyphen creates a solid horizontal line to separate primary keys from standard columns
    ' [PK] indicates the Primary Key, the unique identifier for each record
    ' [FK] indicates a Foreign Key, which references a primary key in another table
    ' [UNIQUE] ensures that no two records can share the same value in this column

entity "countries" as countries {
    * **country_iso2** : CHAR(2) [PK]
    --
    * country_name : VARCHAR(100)
    country_iso3 : CHAR(3)
    continent : CHAR(2)
    currency_code : CHAR(3)
    capital : VARCHAR(100)
    population : BIGINT
}

entity "cities" as cities {
    * **city_id** : INT [PK]
    --
    * city_name : VARCHAR(100)
    city_iata_code : CHAR(3)
    country_iso2 : CHAR(2) [FK]
    latitude : DECIMAL(9,6)
    longitude : DECIMAL(9,6)
    timezone : VARCHAR(50)
}

entity "airports" as airports {
    * **iata_code** : CHAR(3) [PK]
    --
    * icao_code : CHAR(4)
    * name : VARCHAR(150)
    city_id : INT [FK]
    country_iso2 : CHAR(2) [FK]
    city : VARCHAR(100)
    country : VARCHAR(100)
    latitude : DECIMAL(9,6)
    longitude : DECIMAL(9,6)
    timezone : VARCHAR(50)
}

entity "airlines" as airlines {
    * **airline_id** : INT [PK]
    --
    * iata_code : CHAR(2) [UNIQUE]
    * icao_code : CHAR(3)
    * name : VARCHAR(150)
    callsign : VARCHAR(100)
    country_iso2 : CHAR(2) [FK]
    country : VARCHAR(100)
    is_active : BOOLEAN
}

entity "airplane_models" as models {
    * **model_id** : INT [PK]
    --
    * model_code : VARCHAR(50) [UNIQUE]
    * manufacturer : VARCHAR(100)
    seat_capacity : INT
    range_km : INT
    cruising_speed_kmh : INT
}

entity "airplanes" as airplanes {
    * **airplane_id** : INT [PK]
    --
    * tail_number : VARCHAR(20) [UNIQUE]
    * airline_id : INT [FK]
    * model_id : INT [FK]
    manufacture_year : INT
    status : VARCHAR(30)
}

entity "flight_schedules" as schedules {
    * **schedule_id** : INT [PK]
    --
    * flight_number : VARCHAR(10)
    * airline_id : INT [FK]
    * origin_iata : CHAR(3) [FK]
    * destination_iata : CHAR(3) [FK]
    scheduled_departure_time : TIME
    scheduled_arrival_time : TIME
    days_of_week : VARCHAR(7)
    distance_km : INT
}

entity "flights" as flights {
    * **flight_id** : BIGINT [PK]
    --
    * schedule_id : INT [FK]
    * flight_date : DATE
    flight_number : VARCHAR(10)
    airplane_id : INT [FK]
    scheduled_departure : TIMESTAMP
    actual_departure : TIMESTAMP
    scheduled_arrival : TIMESTAMP
    actual_arrival : TIMESTAMP
    departure_delay_min : INT
    arrival_delay_min : INT
    status : VARCHAR(30)
    terminal_dep : VARCHAR(10)
    gate_dep : VARCHAR(10)
    terminal_arr : VARCHAR(10)
    gate_arr : VARCHAR(10)
}

entity "passengers" as passengers {
    * **passenger_id** : BIGINT [PK]
    --
    * first_name : VARCHAR(100)
    * last_name : VARCHAR(100)
    * email : VARCHAR(150) [UNIQUE]
    phone : VARCHAR(30)
    passport_number : VARCHAR(50)
    nationality : CHAR(2) [FK]
    created_at : TIMESTAMP
}

entity "passenger_documents" as documents {
    * **document_id** : BIGINT [PK]
    --
    * passenger_id : BIGINT [FK]
    * document_type : VARCHAR(20) // 'passport' | 'national_id'
    * document_number : VARCHAR(50)
    * issuing_country : CHAR(2) [FK]
    expiration_date : DATE
    created_at : TIMESTAMP
}

entity "bookings" as bookings {
    * **booking_id** : BIGINT [PK]
    --
    * booking_reference : VARCHAR(10) [UNIQUE]
    * passenger_id : BIGINT [FK]
    document_id : BIGINT [FK]
    booking_timestamp : TIMESTAMP
    total_price : DECIMAL(10,2)
    currency : CHAR(3)
    status : VARCHAR(30)
}

entity "itineraries" as itineraries {
    * **itinerary_id** : BIGINT [PK]
    --
    * booking_id : BIGINT [FK]
    * origin_iata : CHAR(3) [FK]
    * destination_iata : CHAR(3) [FK]
    itinerary_type : VARCHAR(30) // 'direct' | 'connecting_stopover'
    total_stops : INT // 0 for direct, 1+ for stopover
    total_duration_minutes : INT
    total_layover_minutes : INT
}

entity "itinerary_segments" as segments {
    * **segment_id** : BIGINT [PK]
    --
    * itinerary_id : BIGINT [FK]
    * segment_sequence : INT // 1, 2, 3...
    * flight_id : BIGINT [FK]
    seat_number : VARCHAR(10)
    cabin_class : VARCHAR(20) // 'economy', 'business', 'first'
    layover_duration_minutes : INT
    boarding_pass_code : VARCHAR(100)
}

' Relationships & Foreign Keys
' [Syntax] 
' EntityA [LeftMarker][LineStyle][RightMarker] EntityB : "relationship description"

' [Left Markers]
' ||: Exactly One (Mandatory)
' |o : Zero or One (Optional)
' }| : One or Many (Mandatory many)
' }o: Zero or Many (Optional many)

' [Line Style]
' Solid Line (--): Denotes an identifying relationship. 
' The child entity relies entirely on the parent entity. In database terms, the parent's primary key is incorporated into the child's primary key.

' Dashed Line (..): Denotes a non-identifying relationship. 
' The child entity can exist independently. The parent's primary key is simply a standard foreign key in the child table.

' [Right Markers]
' ||: Exactly One (Mandatory)
' o|: Zero or One (Optional)
' |{: One or Many (Mandatory many / At least one)
' o{: Zero or Many (Optional many)

' [LeftMarker][LineStyle][RightMarker] examples:
' One-to-Many: ||--o{
' One-to-One (Optional): ||--o|
' One-to-At-Least-One: ||--|{
' Many-to-Many: }o--o{


countries ||--o{ cities : "contains"
countries ||--o{ airports : "located in"
cities ||--o{ airports : "serves"

countries ||--o{ airlines : "based in"
countries ||--o{ passengers : "citizenship"

airlines ||--o{ airplanes : "operates"
models ||--o{ airplanes : "specifies"

airlines ||--o{ schedules : "publishes"
airports ||--o{ schedules : "origin"
airports ||--o{ schedules : "destination"

schedules ||--o{ flights : "generates instance"
airplanes ||--o{ flights : "assigned to"

passengers ||--o{ documents : "holds"
countries ||--o{ documents : "issued by"
documents ||--o{ bookings : "presented for"

passengers ||--o{ bookings : "makes"
bookings ||--o{ itineraries : "contains"

airports ||--o{ itineraries : "journey origin"
airports ||--o{ itineraries : "journey destination"

itineraries ||--|{ segments : "composed of"
flights ||--o{ segments : "fulfills leg"

@enduml
